# MasonicCore environment template.
# Copy to .env and adjust values. Prefix APP_ namespaces service config.

# Application
APP_ENV=development
HTTP_ADDR=:8080

# PostgreSQL
DATABASE_URL=postgres://masonic:masonic@localhost:5432/masoniclounge?sslmode=disable

# Auth (JWT_SECRET MUST be >= 32 chars; generate with: openssl rand -hex 32)
JWT_SECRET=change-me-please-use-at-least-32-characters
JWT_ISSUER=masoniccore
ACCESS_TTL_MINUTES=15
REFRESH_TTL_DAYS=30

# Session cookie
REFRESH_COOKIE_NAME=masonic_refresh
REFRESH_COOKIE_SECURE=false